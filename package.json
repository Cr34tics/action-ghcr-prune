{
  "name": "action-ghcr-prune",
  "version": "1.0.0",
  "description": "GitHub Action to prune containers from GitHub Container Registry (ghcr.io)",
  "main": "dist/index.js",
  "packageManager": "yarn@4.16.0",
  "scripts": {
    "build": "ncc build src/index.ts -o dist -m --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cr34tics/action-ghcr-prune.git"
  },
  "keywords": [
    "github",
    "actions",
    "ghcr",
    "container-registry",
    "prune",
    "cleanup",
    "docker"
  ],
  "author": "Cr34tics",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Cr34tics/action-ghcr-prune/issues"
  },
  "homepage": "https://github.com/Cr34tics/action-ghcr-prune#readme",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.3",
    "@vercel/ncc": "0.44.0",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "10.4.1",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.8"
  }
}
