{
  "name": "action-ghcr-prune",
  "version": "1.0.0",
  "description": "GitHub Action to prune containers from GitHub Container Registry (ghcr.io)",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist -m --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlaurin/action-ghcr-prune.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vlaurin/action-ghcr-prune/issues"
  },
  "homepage": "https://github.com/vlaurin/action-ghcr-prune#readme",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.0",
    "@vercel/ncc": "^0.38.4",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
