{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "security:minimumReleaseAgeNpm"],
  "forkProcessing": "enabled",
  "dependencyDashboard": true,
  "timezone": "Europe/Stockholm",
  "updateNotScheduled": false,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "separateMultipleMinor": false,
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "lock file maintenance"
  },
  "packageRules": [
    {
      "description": ["Group all regular dependency and toolchain updates"],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "bump"
      ],
      "schedule": ["* 0-3 * * 5"],
      "groupName": "weekly dependency updates",
      "groupSlug": "weekly-dependencies",
      "groupSingleUpdates": true,
      "addLabels": ["dependencies"]
    },
    {
      "description": ["Label npm/yarn updates"],
      "matchManagers": ["npm"],
      "addLabels": ["dependencies", "npm", "yarn"]
    },
    {
      "description": ["Label Go updates"],
      "matchManagers": ["gomod"],
      "addLabels": ["dependencies", "go"]
    },
    {
      "description": ["Label Python updates"],
      "matchCategories": ["python"],
      "addLabels": ["dependencies", "python"]
    },
    {
      "description": ["Label Docker image updates"],
      "matchManagers": ["dockerfile", "docker-compose"],
      "addLabels": ["dependencies", "docker"]
    },
    {
      "description": ["Label GitHub Actions updates"],
      "matchManagers": ["github-actions"],
      "addLabels": ["dependencies", "github-actions"]
    },
    {
      "description": ["Extra npm age gate"],
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "assignees": []
  }
}
